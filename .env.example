# Required for GitHub API (optional but recommended to avoid rate limits)
# Use a classic personal access token with read:public_repo scope only
# NEVER commit real values to version control
GITHUB_TOKEN=

# Optional: Enable live LeetCode data fetch (unofficial endpoint)
# Set to "true" to enable; endpoint may not be stable
LEETCODE_LIVE=false

# Your canonical site URL (for sitemap, OG, etc.)
# Example: https://khushalmidha.dev
NEXT_PUBLIC_SITE_URL=
